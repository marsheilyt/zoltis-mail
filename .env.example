# ---------------------------------------------------------------
# Zoltis Mail - Community Edition settings (copy to .env)
# ---------------------------------------------------------------
# Address people open in the browser for webmail + admin console
WEB_HOST=webmail.example.com
# Your mail server's name. Must have an A record pointing at this server,
# and the server's reverse DNS (PTR) should point back to it.
MAIL_HOST=mail.example.com
# Public IPv4 address of this server (shown in the DNS records to publish)
PUBLIC_IP=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=admin@example.com
# Product name shown to users. Community Edition always shows "Zoltis Mail" and its logo;
# a different name only takes effect on Enterprise (custom branding).
APP_NAME=Zoltis Mail
# Antivirus (ClamAV): only for servers with 4 GB RAM or more; install.sh turns it on there.
# To turn it on: ANTIVIRUS=true and COMPOSE_PROFILES=antivirus. Below 4 GB keep it off;
# the risky-attachment blocker still works.
ANTIVIRUS=false
COMPOSE_PROFILES=
# Max parallel Postfix processes. Use 20 on small servers (1-2 GB RAM), 100 otherwise.
POSTFIX_PROCESS_LIMIT=100
# Optional fixed first-run setup code (otherwise one is generated: docker compose logs web | grep SETUP)
SETUP_TOKEN=
# License key (free): required from 2.3.0. You have 7 days after installing to add it. Get it on
# zoltismail.com > My account > License keys > Community Edition, entering this server's IP (PUBLIC_IP).
# Paste it in Admin console > License (or here). LICENSE_REQUIRED=false is for development only.
LICENSE_REQUIRED=true
LICENSE_KEY=
TZ=UTC
