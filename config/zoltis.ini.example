# Zoltis Mail - advanced configuration (optional)
# Copy to config/zoltis.ini, edit, then:  docker compose restart web
# The Docker setup already configures the mail server through docker-compose.yml / .env;
# use this file for attachment, antivirus and branding options.
# Any value can also be an environment variable ZOLTIS_<SECTION>_<KEY>.

[server]
# In Docker the web container listens on 0.0.0.0:8080 behind Caddy.
listen = 127.0.0.1
port = 8080
# true when users reach Zoltis Mail over HTTPS (sets Secure cookies + HSTS)
behind_https = true
trust_proxy = true
session_hours = 12
max_upload_mb = 25
data_dir = /var/lib/zoltis

[mail_server]
# bundled  = Zoltis runs its own Postfix + Dovecot (Docker default; admin console creates accounts)
# external = connect to an existing IMAP/SMTP server (admin console manages webmail seats only)
mode = bundled
hostname = mail.example.com

[imap]
# Your existing IMAP server. "auto" = mail.<domain of the user's email>
host = mail.example.com
port = 993
# ssl (993) | starttls (143) | plain (143, only for localhost)
security = ssl
verify_cert = true
timeout = 30

[smtp]
# Your existing SMTP submission server.
host = mail.example.com
port = 587
# starttls (587) | ssl (465) | plain (25, only for localhost relay)
security = starttls
verify_cert = true
auth = true
timeout = 30

[antivirus]
# ClamAV via clamd (the clamav container; ANTIVIRUS=true in .env).
enabled = false
# unix socket (auto-detected when "auto"), or "-" to use host/port below
socket = auto
host = 127.0.0.1
port = 3310
# block | allow  -> what to do when clamd is down or a file is too big to scan
fail_mode = block
max_scan_mb = 50
scan_incoming = true
scan_outgoing = true

[attachments]
# Blocks risky file types in sent and received mail, inside archives
# (zipped folders) and in folders attached from the browser.
enabled = true
check_outgoing = true
check_incoming = true
# block = received risky attachments can't be downloaded; warn = user is cautioned first
incoming_action = block
# Leave empty to use the built-in list (exe, bat, cmd, scr, js, vbs, ps1, msi, jar, lnk, iso, hta, dll, ...)
blocked_extensions =
# Add your own on top of the built-in list, e.g.:  extra_blocked_extensions = py, sh, apk
extra_blocked_extensions =
# Never block these (exceptions), e.g. allowed_extensions = iso
allowed_extensions =
# Also block Unix/Python scripts and packages (sh, py, deb, rpm, ...)
strict_scripts = false
# Office files with macros (docm, xlsm, hidden vbaProject.bin): allow | warn | block
macro_documents = warn
# Password-protected archives can't be inspected: allow | warn | block
encrypted_archives = block
# RAR / 7z can't be opened with the standard library: allow | warn | block
uninspectable_archives = warn
# Catch programs renamed to harmless extensions (photo.jpg that is really an .exe)
detect_executables_by_content = true
scan_archives = true
archive_max_depth = 3
archive_max_files = 5000
archive_max_uncompressed_mb = 1024

[branding]
app_name = Zoltis Mail
company =
primary_color = #0b57d0
# Lets users type just "john" instead of "john@example.com"
default_domain =
# Only allow logins from these domains (comma separated). Empty = any.
allowed_domains =

[license]
# Community Edition: every install needs a (free) license key before it can create
# email accounts. Enter it on the setup screen, in Admin console > License, with
# `zoltis license activate <KEY>`, or set ZOLTIS_LICENSE_KEY. It is activated online
# once and renewed daily, so the server needs outbound HTTPS to the licensing portal.
# server = https://licensing.zoltis.example
# Sign-up page behind the admin console's "Upgrade to Mail Pro" buttons
# (the app adds ?from=community&license=<id>&domains=<list>):
# upgrade_url = https://licensing.zoltis.example/upgrade
# Enterprise Edition only
key_file = /etc/zoltis/license.key

# ---------------------------------------------------------------------------
# Multi-domain hosting: override servers per email domain
# [domain:client2.com]
# imap_host = imap.client2.com
# imap_port = 993
# imap_security = ssl
# smtp_host = smtp.client2.com
# smtp_port = 465
# smtp_security = ssl
